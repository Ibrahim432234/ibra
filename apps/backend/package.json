{
  "name": "@autoinvoice/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "rimraf dist && prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint ./src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "fs-extra": "^11.2.0",
    "pdfkit": "^0.14.0",
    "stripe": "^16.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/pdfkit": "^0.12.12",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "eslint-config-standard-with-typescript": "^39.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-promise": "^7.1.0",
    "prisma": "^5.18.0",
    "rimraf": "^5.0.9",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.3.2",
    "typescript": "^5.5.4"
  }
